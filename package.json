{
  "name": "@local/pi-prewalk",
  "version": "0.1.0",
  "description": "Same-session planner-to-executor handoff for stock Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javonmcgilberry/pi-prewalk.git"
  },
  "homepage": "https://github.com/javonmcgilberry/pi-prewalk#readme",
  "bugs": {
    "url": "https://github.com/javonmcgilberry/pi-prewalk/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "agent-handoff",
    "prewalk"
  ],
  "files": [
    "extensions",
    "src",
    "scripts",
    "prompts",
    "benchmark",
    "docs/README.md",
    "docs/analytics.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "prewalk.example.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/prewalk.ts"
    ]
  },
  "scripts": {
    "lint": "biome check .",
    "smoke:rpc": "node scripts/smoke-rpc.mjs",
    "smoke:rpc-cross-provider": "node scripts/smoke-rpc-cross-provider.mjs",
    "verify:teeth": "node scripts/verify-teeth.mjs",
    "canary:provider": "node scripts/canary-provider.mjs",
    "benchmark": "node scripts/benchmark-prewalk.mjs",
    "benchmark:report": "node scripts/benchmark-report.mjs",
    "test": "vitest run",
    "test:agent-loop": "vitest run test/agent-loop.test.ts test/codex-conversion.test.ts test/benchmark-agent-loop.test.ts",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "pack:dry-run": "npm pack --dry-run --json"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@howaboua/pi-codex-conversion": "3.0.10",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
